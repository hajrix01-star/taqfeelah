# Development defaults: DB as sole source of truth (matches production source-unification policy).
# Override DATABASE_URL in .env.local if your local Postgres differs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taqfeelah

APP_MODE=production
NEXT_PUBLIC_APP_MODE=production

NEXT_PUBLIC_CLOSEOUTS_API_ENABLED=true
NEXT_PUBLIC_ENTRIES_API_ENABLED=true
NEXT_PUBLIC_ORG_CONFIG_API_ENABLED=true
NEXT_PUBLIC_PHASE9_API_ENABLED=true
NEXT_PUBLIC_REGISTER_ENTRIES_PAGINATION_ENABLED=true
NEXT_PUBLIC_DISABLE_BROWSER_PERSISTENCE=true

# Real auth only — see docs/PRELAUNCH_CLEANUP.md and docs/PHASE_10_AUTH.md.
NEXT_PUBLIC_AUTH_API_ENABLED=true
AUTH_DB_CREDENTIALS_ENABLED=true
ALLOW_HEADER_AUTH_CONTEXT=false

# Owner password reset email (configure one provider for production).
AUTH_PASSWORD_RESET_ENABLED=true
AUTH_EMAIL_FROM=noreply@taqfeelah.app
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Optional: shared login rate limiting across instances (falls back to in-memory when unset).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

AUTH_SESSION_SECRET=dev-session-secret-change-me
AUTH_ORGANIZATION_ID=8f63cf87-f2e2-4e2a-a20e-e8f637f0a9e1
AUTH_OWNER_USER_ID=e8f3e35b-6051-4da3-8b10-979700c2f00f
NEXT_PUBLIC_CLOSEOUTS_API_ORGANIZATION_ID=8f63cf87-f2e2-4e2a-a20e-e8f637f0a9e1
NEXT_PUBLIC_CLOSEOUTS_API_OWNER_USER_ID=e8f3e35b-6051-4da3-8b10-979700c2f00f
# Optional legacy ID maps for local dev bootstrap only (see scripts/seed-closeouts-foundation.mjs).
# New accounts are created via SaaS Admin — maps are not required at launch.
# NEXT_PUBLIC_CLOSEOUTS_STORE_ID_MAP=
# NEXT_PUBLIC_CLOSEOUTS_USER_ID_MAP=
# NEXT_PUBLIC_CLOSEOUTS_SALES_CHANNEL_ID_MAP=
