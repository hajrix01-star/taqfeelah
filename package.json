{
  "name": "taqfeelah-v2",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.15"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --hostname 0.0.0.0 --port 3000",
    "mobile:sync": "pnpm clean && node scripts/print-lan-url.mjs && next dev --hostname 0.0.0.0 --port 3000",
    "predev": "node scripts/print-lan-url.mjs",
    "lan": "node scripts/print-lan-url.mjs",
    "preview:lan": "NEXT_PUBLIC_APP_MODE=production pnpm build && node scripts/print-lan-url.mjs && NEXT_PUBLIC_APP_MODE=production next start --hostname 0.0.0.0 --port 3000",
    "firewall:allow": "powershell -ExecutionPolicy Bypass -File scripts/allow-firewall-port.ps1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "start:lan": "node scripts/print-lan-url.mjs && next start --hostname 0.0.0.0 --port 3000",
    "prepare": "husky",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:refactor": "pnpm lint && pnpm typecheck && pnpm test && pnpm smoke:browser",
    "smoke:browser": "playwright test",
    "smoke:closeouts": "node scripts/closeouts-api-smoke.mjs",
    "check:db-source": "node scripts/db-source-unification-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline-migrations": "node scripts/baseline-drizzle-migrations.mjs",
    "db:push": "drizzle-kit push",
    "db:check": "node scripts/check-db-state.mjs",
    "db:verify-plan": "node scripts/verify-plan-table-db.mjs",
    "db:cleanup-orphans": "node scripts/cleanup-orphan-entries.mjs",
    "db:cleanup-orphans:apply": "node scripts/cleanup-orphan-entries.mjs --apply",
    "db:cleanup-inline-attachments": "node scripts/cleanup-inline-attachments.mjs",
    "db:cleanup-inline-attachments:apply": "node scripts/cleanup-inline-attachments.mjs --apply",
    "db:cleanup-inline-attachments:apply:vacuum": "node scripts/cleanup-inline-attachments.mjs --apply --vacuum",
    "db:reconcile-entitlements": "node scripts/reconcile-organization-entitlements.mjs --dry-run",
    "db:reconcile-entitlements:apply": "node scripts/reconcile-organization-entitlements.mjs --apply",
    "db:studio": "drizzle-kit studio",
    "db:seed:closeouts": "node scripts/seed-closeouts-foundation.mjs",
    "db:seed:performance": "node scripts/seed-performance-fixture.mjs",
    "db:seed:performance:apply": "node scripts/seed-performance-fixture.mjs --apply",
    "db:seed:performance:purge": "node scripts/seed-performance-fixture.mjs --purge --apply",
    "benchmark:api": "node scripts/benchmark-api-endpoints.mjs",
    "db:reset:foundation": "node scripts/reset-and-seed-modern-foundation.mjs",
    "db:seed:auth": "node scripts/seed-auth-credentials.mjs",
    "db:migrate:auth": "node scripts/migrate-runtime-auth-to-identities.mjs",
    "db:seed:saas": "node scripts/seed-saas-foundation.mjs",
    "saas:aggregate": "node --experimental-strip-types scripts/aggregate-saas-analytics.ts",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@serwist/next": "^9.5.11",
    "@tanstack/react-query": "^5.90.2",
    "@upstash/redis": "^1.38.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.23.12",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.542.0",
    "next": "^15.5.2",
    "nodemailer": "^8.0.11",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.8.1",
    "serwist": "^9.5.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "husky": "^9.1.7",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
