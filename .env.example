# Copy to `.env.local` for local overrides. See docs/PRELAUNCH_CLEANUP.md.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taqfeelah

APP_MODE=production
NEXT_PUBLIC_APP_MODE=production

NEXT_PUBLIC_CLOSEOUTS_API_ENABLED=true
NEXT_PUBLIC_ENTRIES_API_ENABLED=true
NEXT_PUBLIC_ORG_CONFIG_API_ENABLED=true
NEXT_PUBLIC_PHASE9_API_ENABLED=true
NEXT_PUBLIC_REGISTER_ENTRIES_PAGINATION_ENABLED=true
NEXT_PUBLIC_DISABLE_BROWSER_PERSISTENCE=true

NEXT_PUBLIC_AUTH_API_ENABLED=true
AUTH_DB_CREDENTIALS_ENABLED=true
ALLOW_HEADER_AUTH_CONTEXT=false

AUTH_SESSION_SECRET=change-me-min-16-chars
AUTH_SESSION_COOKIE_NAME=taqfeelah_session

# Optional: only when using scripts/seed-closeouts-foundation.mjs for local dev
# AUTH_ORGANIZATION_ID=
# AUTH_OWNER_USER_ID=
# NEXT_PUBLIC_CLOSEOUTS_API_ORGANIZATION_ID=
# NEXT_PUBLIC_CLOSEOUTS_API_OWNER_USER_ID=

# SaaS platform admin (comma-separated user UUIDs)
# SAAS_PLATFORM_ADMIN_USER_IDS=
# SAAS_ADMIN_API_ENABLED=true
# NEXT_PUBLIC_SAAS_ADMIN_ENABLED=true

# Support WhatsApp (Saudi local 05XXXXXXXX or 9665XXXXXXXX). Production uses 966533507223.
# NEXT_PUBLIC_SUPPORT_WHATSAPP=966533507223

# Password reset email (required for /saas-admin/forgot-password and /auth/forgot-password)
AUTH_PASSWORD_RESET_ENABLED=true
AUTH_EMAIL_FROM=noreply@taqfeelah.app
# Public owner self-signup (/signup) — requires email delivery above
# AUTH_PUBLIC_SIGNUP_ENABLED=true
# NEXT_PUBLIC_PUBLIC_SIGNUP_ENABLED=true
# AUTH_SIGNUP_SYSTEM_ACTOR_USER_ID=
# Choose one provider:
# RESEND_API_KEY=re_...
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Owner settings: flattened store page (proposal A). Set false to restore drill-down navigation.
# NEXT_PUBLIC_OWNER_SETTINGS_FLATTENED_STORE=false

# Optional shared login rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Deploy smoke-test owner credentials (GitHub Actions secrets only — not app runtime auth)
# AUTH_VERIFY_OWNER_USERNAME=
# AUTH_VERIFY_OWNER_PASSWORD=

# Attachment storage (default: local on production VPS, inline in tests)
# ATTACHMENT_STORAGE_MODE=local
# ATTACHMENT_STORAGE_ROOT=/var/lib/taqfeelah/attachments
